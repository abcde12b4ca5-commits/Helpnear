rules_version = '2';
// Helpnear security rules. These are the only backend: treat as production code.
// Default deny. Reads of get()/exists()/getAfter() are billed and capped per request (10 single, 20 batch/transaction).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function allKeys(keys) {
      return request.resource.data.keys().hasAll(keys) && request.resource.data.keys().hasOnly(keys);
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------- public config (no secrets inside) ----------
    match /config/{docId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /categories/{docId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /legal/{docId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // ---------- admins (created manually in the console only) ----------
    match /admins/{adminId} {
      allow get: if signedIn() && uid() == adminId;
      allow list, write: if false;
    }
    match /adminLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.adminId == uid()
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------- users ----------
    match /users/{userId} {
      allow get: if signedIn() && (uid() == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && uid() == userId
        && allKeys(['role','displayName','email','termsVersion','privacyVersion','termsAcceptedAt','over18','status','createdAt'])
        && request.resource.data.role in ['client', 'worker']
        && str(request.resource.data.displayName, 1, 60)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.termsVersion == get(/databases/$(database)/documents/legal/terms).data.version
        && str(request.resource.data.privacyVersion, 1, 40)
        && request.resource.data.over18 == true
        && request.resource.data.termsAcceptedAt == request.time
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/config/app).data.signupOpen == true;
      allow update: if signedIn() && uid() == userId
        && changed().hasOnly(['displayName', 'termsVersion', 'privacyVersion', 'termsAcceptedAt'])
        && str(request.resource.data.displayName, 1, 60)
        && (request.resource.data.termsVersion == resource.data.termsVersion
            || (request.resource.data.termsVersion == get(/databases/$(database)/documents/legal/terms).data.version
                && request.resource.data.termsAcceptedAt == request.time));
      allow update: if isAdmin()
        && changed().hasOnly(['status', 'frozenUntil', 'frozenReason', 'needsReview', 'reviewReason'])
        && request.resource.data.status in ['active', 'suspended']
        && (!('frozenUntil' in request.resource.data) || request.resource.data.frozenUntil is timestamp);
      allow delete: if false;
    }

    // ---------- push tokens (FCM). Read by the owner; the edge worker reads them with its service account ----------
    match /users/{userId}/tokens/{tokenId} {
      allow get, list: if signedIn() && uid() == userId;
      allow create: if verified() && uid() == userId
        && allKeys(['token', 'createdAt'])
        && str(request.resource.data.token, 20, 500)
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && uid() == userId;
      allow update: if false;
    }

    // ---------- worker profiles ----------
    function validWorker(d) {
      return str(d.displayName, 1, 60)
        && str(d.bio, 0, 500)
        && d.categories is list && d.categories.size() >= 1 && d.categories.size() <= 5
        && str(d.baseZip, 5, 5) && d.baseZip.matches('^[0-9]{5}$')
        && str(d.city, 1, 80) && str(d.state, 2, 2)
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.radiusMiles in [10, 25, 50]
        && d.matchKeys is list && d.matchKeys.size() >= 1 && d.matchKeys.size() <= 500
        && d.confirmedCategories is list && d.confirmedCategories.hasAll(d.categories)
        && str(d.licenseNote, 0, 200)
        && str(d.insuranceNote, 0, 200);
    }
    match /workers/{workerId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && uid() == workerId
        && userDoc().role == 'worker'
        && allKeys(['displayName','bio','categories','baseZip','city','state','lat','lng','radiusMiles','matchKeys','confirmedCategories','licenseNote','insuranceNote','ratingCount','ratingAverage','isListed','createdAt'])
        && validWorker(request.resource.data)
        && request.resource.data.ratingCount == 0
        && request.resource.data.ratingAverage == 0
        && request.resource.data.isListed == true
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && uid() == workerId
        && changed().hasOnly(['displayName','bio','categories','baseZip','city','state','lat','lng','radiusMiles','matchKeys','confirmedCategories','licenseNote','insuranceNote'])
        && validWorker(request.resource.data);
      allow update: if isAdmin() && changed().hasOnly(['isListed']);
      allow delete: if false;

      // ids of requests this worker declined (hidden from their feed). One small doc, owner only.
      match /private/{docId} {
        allow get: if signedIn() && uid() == workerId && docId == 'declined';
        allow create, update: if signedIn() && uid() == workerId && docId == 'declined'
          && allKeys(['ids'])
          && request.resource.data.ids is list && request.resource.data.ids.size() <= 300;
        allow list, delete: if false;
      }
    }

    // ---------- per-user post cooldown (written in the same batch as a request) ----------
    match /rate/{userId} {
      allow get: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId
        && allKeys(['lastPostAt', 'groupId'])
        && request.resource.data.groupId is string && request.resource.data.groupId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.lastPostAt == request.time;
      allow update: if signedIn() && uid() == userId
        && allKeys(['lastPostAt', 'groupId'])
        && request.resource.data.groupId is string && request.resource.data.groupId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.lastPostAt == request.time
        && resource.data.lastPostAt < request.time - duration.value(60, 's');
      allow delete: if false;
    }

    // ---------- requests ----------
    match /requests/{requestId} {
      allow get: if signedIn() && (
        resource.data.clientId == uid()
        || (verified() && resource.data.status == 'open' && exists(/databases/$(database)/documents/workers/$(request.auth.uid)))
        || exists(/databases/$(database)/documents/requests/$(requestId)/claims/$(request.auth.uid))
        || isAdmin());
      allow list: if signedIn() && (
        resource.data.clientId == uid()
        || (verified() && resource.data.status == 'open' && exists(/databases/$(database)/documents/workers/$(request.auth.uid)))
        || isAdmin());

      allow create: if verified()
        && request.resource.data.clientId == uid()
        && userDoc().role == 'client' && userDoc().status == 'active'
        && !(userDoc().get('frozenUntil', request.time) > request.time)
        && allKeys(['clientId','categoryId','categoryName','zip','city','state','lat','lng','cell','workersNeeded','groupId','groupSize','title','description','urgency','budgetRange','status','claimsCount','matchKey','createdAt','expiresAt','promoted'])
        && str(request.resource.data.categoryId, 1, 60)
        && str(request.resource.data.categoryName, 1, 80)
        && str(request.resource.data.title, 5, 100)
        && str(request.resource.data.description, 10, 2000)
        && request.resource.data.urgency in ['asap', 'this_week', 'flexible']
        && str(request.resource.data.budgetRange, 0, 40)
        && str(request.resource.data.zip, 5, 5) && request.resource.data.zip.matches('^[0-9]{5}$')
        && str(request.resource.data.city, 1, 80) && str(request.resource.data.state, 2, 2)
        && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && str(request.resource.data.cell, 4, 4) && request.resource.data.cell.matches('^[0-9a-z]{4}$')
        && request.resource.data.workersNeeded is int
        && request.resource.data.workersNeeded >= 1 && request.resource.data.workersNeeded <= 10
        && request.resource.data.workersNeeded <= get(/databases/$(database)/documents/config/app).data.get('maxWorkersPerRequest', 10)
        // a post is a group of 1 to 5 positions (one request doc each, id = groupId-0 .. groupId-4), all written in one batch
        && request.resource.data.groupId is string && request.resource.data.groupId.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.groupId == getAfter(/databases/$(database)/documents/rate/$(request.auth.uid)).data.groupId
        && requestId.matches('^' + request.resource.data.groupId + '-[0-4]$')
        && request.resource.data.groupSize is int && request.resource.data.groupSize >= 1 && request.resource.data.groupSize <= 5
        && request.resource.data.status == 'open'
        && request.resource.data.claimsCount == 0
        && request.resource.data.promoted == false
        && request.resource.data.matchKey == request.resource.data.categoryId + '|' + request.resource.data.cell
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
        && get(/databases/$(database)/documents/categories/$(request.resource.data.categoryId)).data.enabled == true
        && !get(/databases/$(database)/documents/categories/$(request.resource.data.categoryId)).data.get('disabledStates', []).hasAny([request.resource.data.state])
        && getAfter(/databases/$(database)/documents/rate/$(request.auth.uid)).data.lastPostAt == request.time
        && existsAfter(/databases/$(database)/documents/requests/$(requestId)/private/contact);

      // owner may stop taking new workers (accepted workers can still finish)
      allow update: if signedIn() && resource.data.clientId == uid()
        && resource.data.status in ['open', 'filled']
        && changed().hasOnly(['status'])
        && request.resource.data.status == 'closed';

      // admin moderation
      allow update: if isAdmin()
        && changed().hasOnly(['status'])
        && request.resource.data.status in ['open', 'filled', 'closed', 'expired', 'removed'];

      // a worker accepts: counter +1 within the client's worker count, together with the new claim doc (same transaction)
      allow update: if verified()
        && changed().hasOnly(['claimsCount', 'status'])
        && request.resource.data.claimsCount == resource.data.claimsCount + 1
        && request.resource.data.claimsCount <= resource.data.workersNeeded
        && request.resource.data.status == (request.resource.data.claimsCount >= resource.data.workersNeeded ? 'filled' : 'open')
        && resource.data.status == 'open'
        && resource.data.expiresAt > request.time
        && !exists(/databases/$(database)/documents/requests/$(requestId)/claims/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/requests/$(requestId)/claims/$(request.auth.uid));

      // a worker is released (cancelled by the worker or the client): counter -1 in the same transaction as the claim's cancellation
      allow update: if verified()
        && changed().hasOnly(['claimsCount', 'status', 'lastWorkerId'])
        && request.resource.data.lastWorkerId is string
        && request.resource.data.claimsCount == resource.data.claimsCount - 1
        && request.resource.data.status == (resource.data.status == 'filled' ? 'open' : resource.data.status)
        && (uid() == resource.data.clientId || uid() == request.resource.data.lastWorkerId || isAdmin())
        && exists(/databases/$(database)/documents/requests/$(requestId)/claims/$(request.resource.data.lastWorkerId))
        && get(/databases/$(database)/documents/requests/$(requestId)/claims/$(request.resource.data.lastWorkerId)).data.status in ['accepted', 'disputed']
        && getAfter(/databases/$(database)/documents/requests/$(requestId)/claims/$(request.resource.data.lastWorkerId)).data.status == 'cancelled';

      allow delete: if false;

      match /private/{docId} {
        function validContact(d) {
          return str(d.phone, 0, 30) && str(d.email, 0, 120)
            && (d.phone.size() > 0 || d.email.size() > 0)
            && d.preferredContactMethod in ['phone', 'email', 'text'];
        }
        allow create: if signedIn() && docId == 'contact'
          && getAfter(/databases/$(database)/documents/requests/$(requestId)).data.clientId == uid()
          && allKeys(['phone', 'email', 'preferredContactMethod'])
          && validContact(request.resource.data);
        allow update: if signedIn() && docId == 'contact'
          && get(/databases/$(database)/documents/requests/$(requestId)).data.clientId == uid()
          && allKeys(['phone', 'email', 'preferredContactMethod'])
          && validContact(request.resource.data);
        allow get: if signedIn() && docId == 'contact' && (
          get(/databases/$(database)/documents/requests/$(requestId)).data.clientId == uid()
          || (exists(/databases/$(database)/documents/requests/$(requestId)/claims/$(request.auth.uid))
              && get(/databases/$(database)/documents/requests/$(requestId)/claims/$(request.auth.uid)).data.status in ['accepted', 'done', 'confirmed', 'disputed']
              && get(/databases/$(database)/documents/config/app).data.revealContactOnClaim == true)
          || isAdmin());
        allow list, delete: if false;
      }

      match /claims/{workerId} {
        function parentReq() { return get(/databases/$(database)/documents/requests/$(requestId)).data; }
        function validCents(v) { return v is int && v >= 0 && v <= 1000000; }

        // accept: price + scope note, one claim per worker per request
        allow create: if verified() && uid() == workerId
          && allKeys(['workerId', 'requestId', 'clientId', 'categoryId', 'categoryName', 'title', 'workerName', 'status', 'clientAgreed', 'quotedCents', 'note', 'createdAt'])
          && request.resource.data.workerId == workerId
          && request.resource.data.requestId == requestId
          && request.resource.data.clientId == parentReq().clientId
          && request.resource.data.categoryId == parentReq().categoryId
          && request.resource.data.categoryName == parentReq().categoryName
          && request.resource.data.title == parentReq().title
          && str(request.resource.data.workerName, 1, 60)
          && request.resource.data.status == 'accepted'
          && request.resource.data.clientAgreed == false
          && validCents(request.resource.data.quotedCents) && request.resource.data.quotedCents > 0
          && str(request.resource.data.note, 0, 500)
          && request.resource.data.createdAt == request.time
          && parentReq().status == 'open'
          && parentReq().expiresAt > request.time
          && getAfter(/databases/$(database)/documents/requests/$(requestId)).data.claimsCount == parentReq().claimsCount + 1
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
          && !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('frozenUntil', request.time) > request.time)
          && get(/databases/$(database)/documents/workers/$(request.auth.uid)).data.isListed == true
          && get(/databases/$(database)/documents/workers/$(request.auth.uid)).data.categories.hasAny([parentReq().categoryId])
          && get(/databases/$(database)/documents/workers/$(request.auth.uid)).data.matchKeys.hasAny([parentReq().matchKey]);

        allow get, list: if signedIn() && (
          uid() == workerId
          || parentReq().clientId == uid()
          || isAdmin());

        // worker edits price / scope while still being agreed (resets the client's agreement)
        allow update: if verified() && uid() == resource.data.workerId
          && resource.data.status == 'accepted' && resource.data.clientAgreed == false
          && changed().hasOnly(['quotedCents', 'note'])
          && validCents(request.resource.data.quotedCents) && request.resource.data.quotedCents > 0
          && str(request.resource.data.note, 0, 500);
        // worker changes a quote that was already agreed: allowed only together with resetting the agreement
        allow update: if verified() && uid() == resource.data.workerId
          && resource.data.status == 'accepted' && resource.data.clientAgreed == true
          && changed().hasOnly(['quotedCents', 'note', 'clientAgreed'])
          && request.resource.data.clientAgreed == false
          && validCents(request.resource.data.quotedCents) && request.resource.data.quotedCents > 0
          && str(request.resource.data.note, 0, 500);
        // the client agrees to the price and the work
        allow update: if verified() && uid() == resource.data.clientId
          && resource.data.status == 'accepted' && resource.data.clientAgreed == false
          && changed().hasOnly(['clientAgreed'])
          && request.resource.data.clientAgreed == true;
        // the worker says the service was done (only after the client agreed), with the final amount
        allow update: if verified() && uid() == resource.data.workerId
          && resource.data.status == 'accepted' && resource.data.clientAgreed == true
          && changed().hasOnly(['status', 'finalCents', 'doneAt'])
          && request.resource.data.status == 'done'
          && validCents(request.resource.data.finalCents)
          && request.resource.data.doneAt == request.time;
        // the client confirms the service was done
        allow update: if verified() && uid() == resource.data.clientId
          && resource.data.status == 'done'
          && changed().hasOnly(['status', 'confirmedAt'])
          && request.resource.data.status == 'confirmed'
          && request.resource.data.confirmedAt == request.time;
        // the client says it is not done yet (or the amount is wrong): back to accepted, counted. The Nth time becomes a dispute (next rule).
        allow update: if verified() && uid() == resource.data.clientId
          && resource.data.status == 'done'
          && changed().hasOnly(['status', 'reopenCount'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.reopenCount == resource.data.get('reopenCount', 0) + 1
          && request.resource.data.reopenCount < get(/databases/$(database)/documents/config/app).data.get('disputeAfterReopens', 2);
        allow update: if verified() && uid() == resource.data.clientId
          && resource.data.status == 'done'
          && changed().hasOnly(['status', 'reopenCount', 'disputeBy', 'disputeReason', 'disputedAt'])
          && request.resource.data.status == 'disputed'
          && request.resource.data.reopenCount == resource.data.get('reopenCount', 0) + 1
          && request.resource.data.reopenCount >= get(/databases/$(database)/documents/config/app).data.get('disputeAfterReopens', 2)
          && request.resource.data.disputeBy == 'client'
          && str(request.resource.data.disputeReason, 5, 500)
          && request.resource.data.disputedAt == request.time;
        // either side raises a dispute (an admin decides). Only after the price was agreed.
        allow update: if verified() && (uid() == resource.data.workerId || uid() == resource.data.clientId)
          && resource.data.clientAgreed == true
          && resource.data.status in ['accepted', 'done']
          && changed().hasOnly(['status', 'disputeBy', 'disputeReason', 'disputedAt'])
          && request.resource.data.status == 'disputed'
          && request.resource.data.disputeBy == (uid() == resource.data.workerId ? 'worker' : 'client')
          && str(request.resource.data.disputeReason, 5, 500)
          && request.resource.data.disputedAt == request.time;
        // either side cancels before it is done; the request counter must drop by one in the same transaction.
        // cancelWasLate records whether the client had already agreed (the scheduled worker turns late cancellations into strikes).
        allow update: if verified() && (uid() == resource.data.workerId || uid() == resource.data.clientId)
          && resource.data.status == 'accepted'
          && changed().hasOnly(['status', 'cancelledBy', 'cancelReason', 'cancelledAt', 'cancelWasLate'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == (uid() == resource.data.workerId ? 'worker' : 'client')
          && request.resource.data.cancelWasLate == resource.data.clientAgreed
          && str(request.resource.data.cancelReason, 3, 200)
          && request.resource.data.cancelledAt == request.time
          && getAfter(/databases/$(database)/documents/requests/$(requestId)).data.claimsCount == parentReq().claimsCount - 1;

        // ----- admin resolves a dispute, or removes a confirmed job (fraud) -----
        allow update: if isAdmin() && resource.data.status == 'disputed'
          && changed().hasOnly(['status', 'finalCents', 'confirmedAt', 'resolution'])
          && request.resource.data.status == 'confirmed'
          && validCents(request.resource.data.finalCents)
          && request.resource.data.confirmedAt == request.time
          && str(request.resource.data.resolution, 0, 300);
        allow update: if isAdmin() && resource.data.status == 'disputed'
          && changed().hasOnly(['status', 'resolution'])
          && request.resource.data.status == 'accepted'
          && str(request.resource.data.resolution, 0, 300);
        allow update: if isAdmin() && resource.data.status == 'disputed'
          && changed().hasOnly(['status', 'cancelledBy', 'cancelReason', 'cancelledAt', 'resolution'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == 'admin'
          && str(request.resource.data.cancelReason, 3, 200)
          && request.resource.data.cancelledAt == request.time
          && str(request.resource.data.resolution, 0, 300)
          && getAfter(/databases/$(database)/documents/requests/$(requestId)).data.claimsCount == parentReq().claimsCount - 1;
        allow update: if isAdmin() && resource.data.status == 'confirmed'
          && changed().hasOnly(['status', 'resolution'])
          && request.resource.data.status == 'voided'
          && str(request.resource.data.resolution, 0, 300);
        allow delete: if false;
      }
    }

    // "my jobs" collection-group queries (worker: workerId == me, client: clientId == me)
    match /{path=**}/claims/{claimId} {
      allow read: if signedIn() && (resource.data.workerId == uid() || resource.data.clientId == uid() || isAdmin());
    }

    // ---------- strikes (fair-use ledger). Written by admins here, and by the scheduled edge worker (service account) ----------
    match /strikes/{strikeId} {
      allow get, list: if signedIn() && (isAdmin() || resource.data.userId == uid());
      allow create: if isAdmin()
        && allKeys(['userId', 'role', 'type', 'requestId', 'note', 'createdAt', 'by'])
        && str(request.resource.data.userId, 1, 128)
        && request.resource.data.role in ['client', 'worker']
        && request.resource.data.type in ['late_cancel', 'no_response', 'conduct', 'warning', 'dispute']
        && str(request.resource.data.requestId, 0, 80)
        && str(request.resource.data.note, 0, 300)
        && request.resource.data.by == 'admin'
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- reports ----------
    match /reports/{reportId} {
      allow create: if verified()
        && allKeys(['reporterId', 'targetType', 'targetId', 'reason', 'status', 'createdAt'])
        && request.resource.data.reporterId == uid()
        && request.resource.data.targetType in ['request', 'worker', 'message']
        && str(request.resource.data.targetId, 1, 100)
        && str(request.resource.data.reason, 3, 500)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin() && changed().hasOnly(['status']);
      allow delete: if false;
    }


    // ---------- reviews: aggregates are computed on read, so they cannot be forged ----------
    match /reviews/{reviewId} {
      allow get, list: if signedIn();
      allow create: if verified()
        && allKeys(['requestId', 'workerId', 'clientId', 'rating', 'text', 'createdAt'])
        && reviewId == request.resource.data.requestId + '_' + request.resource.data.workerId
        && request.resource.data.clientId == uid()
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && str(request.resource.data.text, 0, 500)
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.clientId == uid()
        && exists(/databases/$(database)/documents/requests/$(request.resource.data.requestId)/claims/$(request.resource.data.workerId))
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)/claims/$(request.resource.data.workerId)).data.status == 'confirmed';
      allow update, delete: if false;
    }

    // ---------- in-app notifications (written best-effort by the other side right after a change to a claim) ----------
    match /notifications/{userId}/items/{notifId} {
      allow get, list: if signedIn() && uid() == userId;
      allow create: if verified()
        && allKeys(['type', 'requestId', 'fromId', 'message', 'read', 'createdAt'])
        && request.resource.data.type in ['claim', 'done', 'cancelled_by_worker', 'agreed', 'confirmed', 'reopened', 'cancelled_by_client']
        && request.resource.data.fromId == uid()
        && request.resource.data.read == false
        && str(request.resource.data.message, 1, 140)
        && request.resource.data.createdAt == request.time
        && notifId.matches(request.resource.data.requestId + '_.*')
        && (
          // worker -> client
          (request.resource.data.type in ['claim', 'done', 'cancelled_by_worker']
            && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.clientId == userId
            && exists(/databases/$(database)/documents/requests/$(request.resource.data.requestId)/claims/$(request.auth.uid)))
          // client -> worker
          || (request.resource.data.type in ['agreed', 'confirmed', 'reopened', 'cancelled_by_client']
            && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.clientId == uid()
            && exists(/databases/$(database)/documents/requests/$(request.resource.data.requestId)/claims/$(userId)))
        );
      allow update: if signedIn() && uid() == userId
        && changed().hasOnly(['read']) && request.resource.data.read == true;
      allow delete: if false;
    }

    // ---------- chat (Stage 2, gated by config/app.chatEnabled) ----------
    match /threads/{threadId} {
      allow get: if signedIn()
        && get(/databases/$(database)/documents/config/app).data.chatEnabled == true
        && (resource == null
            || resource.data.clientId == uid()
            || resource.data.workerId == uid()
            || (isAdmin() && resource.data.reported == true));
      allow list: if false;
      allow create: if verified()
        && get(/databases/$(database)/documents/config/app).data.chatEnabled == true
        && allKeys(['requestId', 'workerId', 'clientId', 'blockedBy', 'reported', 'createdAt'])
        && threadId == request.resource.data.requestId + '_' + request.resource.data.workerId
        && (uid() == request.resource.data.clientId || uid() == request.resource.data.workerId)
        && request.resource.data.blockedBy == ''
        && request.resource.data.reported == false
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.clientId == request.resource.data.clientId
        && exists(/databases/$(database)/documents/requests/$(request.resource.data.requestId)/claims/$(request.resource.data.workerId));
      // block / unblock (only the blocker can unblock)
      allow update: if signedIn()
        && get(/databases/$(database)/documents/config/app).data.chatEnabled == true
        && (resource.data.clientId == uid() || resource.data.workerId == uid())
        && changed().hasOnly(['blockedBy'])
        && request.resource.data.blockedBy in ['', uid()]
        && (resource.data.blockedBy == '' || resource.data.blockedBy == uid());
      // flag a thread as reported so an admin may read it
      allow update: if signedIn()
        && (resource.data.clientId == uid() || resource.data.workerId == uid())
        && changed().hasOnly(['reported'])
        && request.resource.data.reported == true;
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if signedIn()
          && get(/databases/$(database)/documents/config/app).data.chatEnabled == true
          && (get(/databases/$(database)/documents/threads/$(threadId)).data.clientId == uid()
              || get(/databases/$(database)/documents/threads/$(threadId)).data.workerId == uid()
              || (isAdmin() && get(/databases/$(database)/documents/threads/$(threadId)).data.reported == true));
        allow create: if verified()
          && get(/databases/$(database)/documents/config/app).data.chatEnabled == true
          && allKeys(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == uid()
          && str(request.resource.data.text, 1, 1000)
          && request.resource.data.createdAt == request.time
          && (get(/databases/$(database)/documents/threads/$(threadId)).data.clientId == uid()
              || get(/databases/$(database)/documents/threads/$(threadId)).data.workerId == uid())
          && get(/databases/$(database)/documents/threads/$(threadId)).data.blockedBy == '';
        allow update, delete: if false;
      }
    }
  }
}
