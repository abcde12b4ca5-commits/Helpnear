# Security headers for every page. The Content-Security-Policy line below is a PLACEHOLDER: `npm run build` runs scripts/headers.mjs, which replaces it with the
# real policy (built by scripts/csp.mjs from your build variables, with SHA-256 hashes of the few inline scripts/styles). Edit the policy in scripts/csp.mjs, not here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: __CSP__
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()
  ! Access-Control-Allow-Origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ZIP lookup files only change when the site is rebuilt: one day in the browser means a returning visitor never downloads them twice
/zip/*
  Cache-Control: public, max-age=86400

/_blog-shell.tpl
  X-Robots-Tag: noindex, nofollow

/cities.json
  Cache-Control: public, max-age=86400

/img/*
  Cache-Control: public, max-age=604800

# Public worker profiles stay out of search results (privacy)
/worker/*
  X-Robots-Tag: noindex, nofollow

/admin*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/chat/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/login
  X-Robots-Tag: noindex
  Cache-Control: no-store
/signup
  X-Robots-Tag: noindex
  Cache-Control: no-store
/post
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/my-requests
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/profile
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/feed
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/dashboard
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/onboarding
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/notifications
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Installable app: manifest and icons are small and rarely change
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

/icon-*
  Cache-Control: public, max-age=604800

/install.js
  Cache-Control: public, max-age=3600

/install.css
  Cache-Control: public, max-age=3600

# The service worker and the offline page must always be re-checked, so a fix reaches every visitor quickly
/firebase-messaging-sw.js
  Cache-Control: no-cache

/offline.html
  Cache-Control: no-cache
  X-Robots-Tag: noindex

/offline.css
  Cache-Control: no-cache

/offline.js
  Cache-Control: no-cache
