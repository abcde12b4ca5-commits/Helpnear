{
  "name": "helpnear",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-zips.mjs && vite",
    "build": "node scripts/build-zips.mjs && tsc -p tsconfig.build.json && vite build && node scripts/prerender.mjs && node scripts/headers.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore",
    "test:rules": "firebase emulators:exec --only firestore --project demo-helpnear \"vitest run tests/rules.test.ts tests/integration\"",
    "seed": "node scripts/seed.mjs",
    "services": "node scripts/enable-services.mjs",
    "test:worker": "vitest run tests/worker.test.ts tests/policy.test.ts tests/articles-worker.test.ts tests/articles-queue.test.ts",
    "worker:deploy": "cd worker && wrangler deploy",
    "worker:dev": "cd worker && wrangler dev",
    "indexnow": "node scripts/indexnow.mjs",
    "zips": "FORCE_ZIPS=1 node scripts/build-zips.mjs",
    "test:unit": "vitest run tests/unit",
    "test": "npm run test:unit && npm run test:worker && npm run test:rules",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-helpnear \"playwright test\"",
    "test:perf": "node tests/perf/run.mjs",
    "test:e2e:public": "playwright test --project=public --project=mobile",
    "test:live": "playwright test -c playwright.live.config.ts",
    "test:all": "npm run lint && npm run typecheck && npm run test:unit && npm run test:worker && npm run test:rules && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0",
    "zipcodes": "^8.0.0"
  }
}
