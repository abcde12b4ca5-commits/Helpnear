# Firebase web config (public values, safe in client code; never put service accounts here)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false
VITE_APPCHECK_SITE_KEY=
SITE_URL=https://REPLACE-WITH-YOUR-DOMAIN
# Edge worker (Turnstile + App Check + push). Leave empty to disable. See worker/README.md
VITE_WORKER_URL=
VITE_TURNSTILE_SITE_KEY=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
